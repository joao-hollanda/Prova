# Copie este arquivo para ".env" e ajuste conforme necessário.

# Define se a aplicação usa dados MOCKADOS (true) ou consome a API C# real (false).
VITE_USE_MOCK=false

# Base da API. Relativa "/api" funciona em dev (proxy do Vite) e em produção
# (a API serve o front na mesma origem). Use uma URL absoluta só se hospedar o
# front separado da API, ex.: https://minha-api.com/api
VITE_API_URL=/api

# Observação: a senha do painel NÃO fica mais no front. O login é feito no backend
# (POST /api/admin/login) e a senha é configurada lá (Admin:Senha / env Admin__Senha).
