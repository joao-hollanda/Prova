<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pcsp.Api</RootNamespace>
    <AssemblyName>Pcsp.Api</AssemblyName>
    <!-- API self-hospedada, sem dependências externas (usa apenas o framework ASP.NET Core). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
